{
  "trailingSlash": false,
  "redirects": [
    { "source": "/admin", "destination": "/membri", "permanent": true },
    { "source": "/admin.html", "destination": "/membri", "permanent": true }
  ],
  "headers": [
    {
      "source": "/membri(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
